{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "daemon-ui",
  "description": "The daemon's web UI (http://127.0.0.1:<port>) may call the four desktop bridge commands, nothing else.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "allow-pick-folder",
    "allow-open-path",
    "allow-platform",
    "allow-set-dark-title"
  ]
}
